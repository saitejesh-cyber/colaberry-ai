{
  "name": "colaberry-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:dist": "NEXT_DIST_DIR=.next-dev next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start -p $PORT",
    "clean:next": "rm -rf .next .next-dev",
    "lint": "eslint",
    "qa:smoke": "bash scripts/qa-runtime-smoke.sh",
    "assets:heroes": "node scripts/generate-enterprise-hero-assets.mjs",
    "assets:heroes:realistic": "node scripts/generate-realistic-page-banners.mjs",
    "assets:icons": "node scripts/generate-enterprise-icons.mjs",
    "assets:videos": "node scripts/generate-hero-motion-videos.mjs",
    "assets:premium": "npm run assets:heroes:realistic && npm run assets:icons && npm run assets:videos",
    "import:podcasts:csv": "node scripts/import-podcasts-csv.mjs",
    "audit:data": "node scripts/audit-data-readiness.mjs"
  },
  "engines": {
    "node": ">=20.11 <24"
  },
  "dependencies": {
    "22": "^0.0.0",
    "next": "^16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.11.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
